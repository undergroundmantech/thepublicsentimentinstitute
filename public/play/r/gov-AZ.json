":[]},"earlyVote":{"ballots":937650,"party":{"d":0.3842958459979737,"r":0.3852866208073375,"o":0.23041753319468886},"estimatedShare":0,"actualMargin":0.09907748093638351,"expectedMargin":3.2842738552894546,"delta":-3.185196374353071,"pace":0.47062490494897735,"expectedEarly":1992351,"expectedTotal":3187432,"date":"2026-10-26"},"news":[],"media":[],"donorSignal":null,"research":{"summary":"Democratic Gov. Katie Hobbs led Trump endorsed Rep. Andy Biggs by 17 points in a mid October HighGround poll, with the pollster saying many Republican voters are not backing their nominees. Hobbs is skipping debates and running on her record with a Republican Legislature while blaming Trump's tariffs and the Iran war for costs, and Biggs promises to phase out the income tax and cut waste.","issues":[{"issue":"Income tax and spending","why":"Biggs would phase out the state income tax and run a DOGE style program to cut waste, fraud and abuse.","src":"https://www.fox10phoenix.com/election/2026-election-debate-arizona-gubernatorial-candidates-face-off"},{"issue":"Medicaid","why":"Biggs says delayed audits put nearly $18 billion in federal AHCCCS money at risk and alleges fraud, while critics warn of cuts to care.","src":"https://www.fox10phoenix.com/election/2026-election-debate-arizona-gubernatorial-candidates-face-off"},{"issue":"Water and data centers","why":"Biggs wants to end all data center tax breaks and back desalination and storage as the state faces water limits.","src":"https://www.fox10phoenix.com/election/2026-election-debate-arizona-gubernatorial-candidates-face-off"},{"issue":"Tariffs and cost of living","why":"Hobbs says Trump's tariffs and the Iran war are raising costs, while Trump says she made Arizona one of the least affordable states.","src":"https://www.kjzz.org/elections/2026-10-15/trump-doesnt-mention-competitive-congressional-candidates-in-arizona-rally"},{"issue":"Border and drug policy","why":"Trump accused Hobbs of siding with cartels over her actions on border and drug bills.","src":"https://www.kjzz.org/elections/2026-10-15/trump-doesnt-mention-competitive-congressional-candidates-in-arizona-rally"}],"storylines":[{"title":"Trump rallies for Biggs","date":"2026-10-14","what":"In Bullhead City, Trump called Hobbs a failed radical left governor and said Biggs would slash property taxes, while Biggs vowed to DOGE the heck out of Arizona.","helps":"R","kind":"rally","src":"https://www.kjzz.org/elections/2026-10-15/trump-doesnt-mention-competitive-congressional-candidates-in-arizona-rally"},{"title":"Hobbs shrugs off insults","date":"2026-10-14","what":"Hobbs said Trump can call her whatever he wants and argued Biggs backed Trump's tariffs and Iran war every step of the way.","helps":"D","kind":"national","src":"https://ktar.com/arizona-politics-news/election/trump-rally-katie-hobbs"},{"title":"Hobbs up 17 in new poll","date":"2026-10-13","what":"A HighGround poll found Hobbs ahead by 17 points, with voters citing Trump as a driving force.","helps":"D","kind":"local","src":"https://www.azfamily.com/2026/10/14/new-arizona-poll-shows-democrats-leading-several-key-races/"},{"title":"Biggs blames ads for threats","date":"2026-10-08","what":"Biggs said Hobbs ads tying him to a failed 2013 Colorado City police bill led to death threats, and Hobbs's campaign called his claims false and dangerous.","helps":"mixed","kind":"attack","src":"https://www.azfamily.com/2026/10/09/biggs-says-gov-hobbs-ads-led-death-threats-against-him/"},{"title":"Biggs debates without Hobbs","date":"2026-10-06","what":"At the Clean Elections debate, Biggs faced No Labels nominee Teri Hourihan, who attacked his thin record of passed bills while Biggs went after Medicaid fraud.","helps":"mixed","kind":"debate","src":"https://www.fox10phoenix.com/election/2026-election-debate-arizona-gubernatorial-candidates-face-off"},{"title":"Biggs and GOP launch ad buy","date":"2026-10-01","what":"The Biggs campaign announced a $1.75 million ad buy with the state Republican Party as polls showed him trailing.","helps":"R","kind":"ad","src":"https://cronkitenews.azpbs.org/2026/10/01/andy-biggs-katie-hobbs-arizona-polls-kalshi/"},{"title":"Hobbs declines to debate","date":"2026-07-31","what":"Hobbs's campaign said town halls beat a stage built for soundbites, and Biggs's team said she was ducking a tradition dating to 1954.","helps":"R","kind":"debate","src":"https://www.azfamily.com/2026/07/31/gov-katie-hobbs-declines-debating-andy-biggs-governors-race/"}],"events":[{"title":"Debate or skip","prompt":"The Clean Elections Commission is holding the only governor's debate, and the incumbent skipped a debate in 2022 too. What does the campaign do?","issue":"other","src":"https://www.azfamily.com/2026/07/31/gov-katie-hobbs-declines-debating-andy-biggs-governors-race/","opts":[{"label":"Town halls instead","say":"Skip the stage and hold open town halls and press events across the state.","pos":0.0,"trump":null,"tone":"calm"},{"label":"Show up","say":"Take part in the debate and dare the opponent to join.","pos":0.0,"trump":null,"tone":"fiery"},{"label":"Empty chair attack","say":"Debate and run ads hitting the opponent for hiding from voters.","pos":0.0,"trump":null,"tone":"fiery"}]},{"title":"Phase out income tax","prompt":"A plan to phase out Arizona's income tax and DOGE the state budget is on the table while Medicaid funding is under scrutiny. Where does the campaign stand?","issue":"econ","src":"https://www.fox10phoenix.com/election/2026-election-debate-arizona-gubernatorial-candidates-face-off","opts":[{"label":"Protect services","say":"Oppose the tax phase out and protect Medicaid, schools and child care.","pos":-0.7,"trump":-0.3,"tone":"calm"},{"label":"Targeted relief","say":"Offer targeted credits for families while keeping the budget balanced.","pos":0.1,"trump":null,"tone":"calm"},{"label":"DOGE Arizona","say":"Eliminate the income tax and root out waste and fraud in state programs.","pos":0.9,"trump":0.9,"tone":"fiery"}]},