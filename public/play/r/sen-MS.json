s/news/qa-scott-colom-on-mississippi-senate-race-healthcare-his-viral-campaign-ad-and-more/"},{"title":"Poll touted by Colom was fabricated","date":"2026-10-20","what":"Colom's campaign promoted a Wedgewood poll showing a near tie, and the firm later admitted it staged the poll to expose weak polling standards.","helps":"R","kind":"scandal","src":"https://magnoliatribune.com/2026/10/20/poll-pushed-by-colom-claiming-senate-race-with-hyde-smith-is-tied-was-fake-fabricated/"},{"title":"Colom calls Hyde-Smith chicken over debates","date":"2026-09-29","what":"Colom accepted TV debate invitations and offered a third on her terms. Hyde-Smith's campaign said losing candidates always want a debate about debates.","helps":"mixed","kind":"debate","src":"https://www.wlbt.com/2026/09/30/colom-challenges-hyde-smith-three-debates-senate-race/"}],"events":[{"title":"Rural hospital closures","prompt":"Medicaid cuts threaten several rural hospitals in a state that never expanded Medicaid. You are asked what you would do in Washington.","issue":"health","src":"https://www.mpbonline.org/blogs/news/qa-scott-colom-on-mississippi-senate-race-healthcare-his-viral-campaign-ad-and-more/","opts":[{"label":"Reverse the cuts","say":"Fight to reverse the Medicaid and ACA subsidy cuts that threaten hospitals.","pos":-0.8,"trump":-0.7,"tone":"fiery"},{"label":"Rural hospital fund","say":"Push targeted federal money for rural hospitals without reopening the whole law.","pos":0.1,"trump":0.1,"tone":"calm"},{"label":"Defend the reforms","say":"Stand by the spending reforms and point to federal rural health dollars you secured.","pos":0.8,"trump":0.8,"tone":"calm"}]},{"title":"AI ad complaint","prompt":"The attorney general says an unlabeled AI campaign ad likely broke state election law and threatens an injunction 11 days before the election.","issue":"corruption","src":"https://mississippitoday.org/2026/10/23/scott-colom-says-hell-delete-ai-generated-cindy-hyde-smith-ad-after-ag-fitch-threatens-legal-action/","opts":[{"label":"Call it weaponization","say":"Pull the ad but accuse the other side of using the justice system for politics.","pos":-0.5,"trump":-0.5,"tone":"fiery"},{"label":"Pull it quietly","say":"Delete the ad, label future content and move on to health care.","pos":0,"trump":null,"tone":"calm"},{"label":"Demand accountability","say":"Call for a full investigation and say voters were deceived.","pos":0.7,"trump":0.4,"tone":"fiery"}]},{"title":"Trump comes to Corinth","prompt":"President Trump is coming to north Mississippi to rally for the Republican ticket as tariffs and the Iran war push up prices.","issue":"econ","src":"https://www.wlbt.com/2026/10/21/trump-rallying-mississippi-monday-support-hyde-smith/","opts":[{"label":"Challenge Trump to debate","say":"Say the incumbent is scared and challenge the president himself to debate.","pos":-0.6,"trump":-0.9,"tone":"fiery"},{"label":"Talk local costs","say":"Focus on gas, groceries and farm prices instead of the visit.","pos":0,"trump":-0.2,"tone":"calm"},{"label":"Stand with Trump","say":"Welcome the president and say Mississippi stands with his agenda.","pos":0.8,"trump":1,"tone":"fiery"}]},{"title":"Debate invitations","prompt":"Two TV stations have invited both candidates to debate and one side calls the other chicken for declining.","issue":"other","src":"https://www.wlbt.com/2026/09/30/colom-challenges-hyde-smith-three-debates-senate-race/","opts":[{"label":"Accept every debate","say":"Accept all invitations and offer a third debate on the opponent's terms.","pos":-0.2,"trump":null,"tone":"fiery"},{"label":"One debate","say":"Agree to a single televised debate.","pos":0,"trump":null,"tone":"calm"},{"label":"Run on the record","say":"Decline and say the record speaks for itself while the Senate is in session.","pos":0.3,"trump":null,"tone":"calm"}]}],"debates":[],"endorsements":[{"who":"Donald Trump","for":"R","src":"https://www.wlbt.com/2026/10/21/trump-rallying-mississippi-monday-support-hyde